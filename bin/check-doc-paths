#!/usr/bin/env python3
"""Gate: every repo-relative path claim in taut's guidance surfaces resolves.

Prose binds only what gets checked. Path claims are the corpus's most common
rot class, and taut already gates them in
``tests/test_docs_references.py::test_documented_paths_exist``. This script
is not a second opinion about what a path claim is — it **imports** that
module's grammar (``LINK_PATH_RE``, ``BACKTICK_PATH_RE``, ``ALLOWLIST``,
``_prose_lines``) and its maintained-source list, so there is exactly one
definition in the repository.

What it adds over the pytest gate:

1. A pytest-free entry point, runnable in a propagation or coalescing sweep
   without standing up the test session.
2. Two surfaces the pytest source list does not include:
   ``docs/coalescing.md`` (the coalescing state file, whose run log and
   Verification clause make path claims) and ``docs/plans/README.md`` (the
   structured plan status index, excluded by the blanket ``docs/plans/``
   rule but a maintained routing surface, not an immutable plan body).
   Individual plan *files* stay excluded: they are historical records whose
   paths may legitimately retire.

Adopted from agent-guidance @ ``51626db`` via
``docs/plans/2026-07-28-agent-guidance-delta-wave-plan.md`` (adaptations A1-A3:
grammar imported rather than restated; scan surface set to taut's layout plus
the two gap files; the hub's ``--scaffold`` mode dropped, taut has no
bootstrap script).

Exit 0 when every claim resolves, 1 listing the danglers, 2 on an
invocation or environment problem. Read-only by construction.
"""

from __future__ import annotations

import argparse
import contextlib
import io
import sys
import tempfile
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent

# Surfaces the pytest gate's source list does not cover. Both are maintained
# routing/state documents, not immutable historical records.
EXTRA_SOURCES = [
    Path("docs/coalescing.md"),
    Path("docs/plans/README.md"),
]

# Governed future-artifact allowlist. Adopters may list contractually named
# artifacts that intentionally do not exist yet. Honesty is enforced both
# ways in run():
#   1. A listed path that now exists on disk fails as a stale suppression.
#   2. A listed path that no scanned document claims fails as an unused entry.
DECLARED_FUTURE_ARTIFACTS: set[str] = set()


def _load_grammar():
    """Import taut's single definition of a path claim, or explain why not."""
    sys.path.insert(0, str(REPO_ROOT))
    try:
        from tests import test_docs_references as gate
    except Exception as exc:  # pragma: no cover  # noqa: BLE001 approved [DOM-10.2.1] [RUFF-SUP-065] exception
        print(
            "check-doc-paths: cannot import tests/test_docs_references.py "
            f"({exc}). Run under the project environment, e.g. "
            "`uv run bin/check-doc-paths`."
        )
        sys.exit(2)
    return gate


def _root_sources(root: Path) -> list[Path]:
    candidates = [
        root / "README.md",
        root / "AGENTS.md",
        root / "CLAUDE.md",
        root / "llms.txt",
        root / "docs" / "README.md",
        root / "docs" / "agent-kernel.md",
        *sorted((root / "extensions").glob("*/README.md")),
        *sorted((root / "docs" / "agent-context").glob("*.md")),
        *sorted((root / "docs" / "agent-context" / "runbooks").glob("*.md")),
        *sorted((root / "skills").glob("**/*.md")),
        *sorted((root / "docs" / "implementation").glob("*.md")),
        *sorted((root / "docs" / "specs").glob("*.md")),
    ]
    return [p for p in dict.fromkeys(candidates) if p.is_file()]


def sources(gate, root: Path = REPO_ROOT) -> list[Path]:
    paths = (
        list(gate._markdown_path_sources())
        if root == REPO_ROOT
        else _root_sources(root)
    )
    for extra in EXTRA_SOURCES:
        candidate = root / extra
        if candidate.is_file() and candidate not in paths:
            paths.append(candidate)
    return paths


def _stale_allowlist_failures(root: Path, declared_future: set[str]) -> list[str]:
    return [
        f"bin/check-doc-paths: `{declared}` exists but is still "
        "listed in DECLARED_FUTURE_ARTIFACTS — remove the stale "
        "suppression entry"
        for declared in sorted(declared_future)
        if (root / declared).exists() or (root / declared).is_symlink()
    ]


def _scan_source(
    source: Path,
    root: Path,
    gate,
    active_declared: set[str],
    claimed_allowlisted: set[str],
) -> tuple[int, list[str]]:
    if not source.is_file():
        return 0, []
    relative = source.relative_to(root)
    failures: list[str] = []
    claim_count = 0
    for lineno, line in gate._prose_lines(source):
        claims = [
            match.group(1)
            for regex in (gate.LINK_PATH_RE, gate.BACKTICK_PATH_RE)
            for match in regex.finditer(line)
        ]
        for claim in claims:
            if claim in active_declared or claim in gate.ALLOWLIST:
                claimed_allowlisted.add(claim)
                continue
            claim_count += 1
            target = root / claim
            if not (target.exists() or target.is_symlink()):
                failures.append(f"{relative}:{lineno}: `{claim}` does not resolve")
    return claim_count, failures


def run(root: Path, *, declared_future: set[str] | None = None) -> int:
    gate = _load_grammar()
    active_declared = (
        DECLARED_FUTURE_ARTIFACTS if declared_future is None else declared_future
    )
    scanned = sources(gate, root)
    failures = _stale_allowlist_failures(root, active_declared)
    claimed_allowlisted: set[str] = set()
    claim_count = 0
    for source in scanned:
        count, src_failures = _scan_source(
            source, root, gate, active_declared, claimed_allowlisted
        )
        claim_count += count
        failures.extend(src_failures)
    failures.extend(
        f"bin/check-doc-paths: `{unused}` is allowlisted in "
        "DECLARED_FUTURE_ARTIFACTS but no scanned surface claims it — "
        "remove the unused suppression entry"
        for unused in sorted(active_declared - claimed_allowlisted)
    )

    extra_present = [str(extra) for extra in EXTRA_SOURCES if (root / extra).is_file()]
    print(
        f"check-doc-paths: {len(scanned)} source(s), {claim_count} path claim(s); "
        f"beyond the pytest gate's list: {', '.join(extra_present) or 'none'}"
    )
    if failures:
        print(f"  {len(failures)} dangling path claim(s):")
        for failure in failures:
            print(f"    {failure}")
        print(
            "  Fix the document, or tighten the recognized syntax in "
            "tests/test_docs_references.py, or add a reasoned ALLOWLIST entry."
        )
        return 1
    print(f"  OK ({root})")
    return 0


def _build_probe_tree(
    tmp: str,
    *,
    spec_text: str,
    materialize: str | None = None,
    symlink: tuple[str, str] | None = None,
) -> Path:
    root = Path(tmp)
    (root / "docs" / "specs").mkdir(parents=True)
    (root / "docs" / "specs" / "01-sample.md").write_text(spec_text, encoding="utf-8")
    if materialize is not None:
        target = root / materialize
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text("{}", encoding="utf-8")
    if symlink is not None:
        (root / symlink[0]).symlink_to(symlink[1])
    return root


def self_test() -> int:
    """Firing tests for claim scanning, fenced blocks, and allowlist honesty."""
    future_path = "docs/specs/99-future-artifact.md"
    probes = [
        (
            "unlisted missing claim was not flagged",
            "`docs/specs/missing.md`\n",
            set(),
            None,
            None,
            1,
        ),
        (
            "fenced code block sample path was wrongly flagged",
            "```markdown\n`docs/specs/fenced-example-only.md`\n```\n",
            set(),
            None,
            None,
            0,
        ),
        (
            "info-string fence line inside code block closed early and hid trailing prose",
            "```\n``` markdown\n```\n`docs/specs/missing-after-fence.md`\n",
            set(),
            None,
            None,
            1,
        ),
        (
            "4-space-indented fence line hid broken path claim",
            "    ```\n`docs/specs/indented-missing.md`\n    ```\n",
            set(),
            None,
            None,
            1,
        ),
        (
            "unclosed fence hid interior sample path",
            "```markdown\n`docs/specs/unclosed-fence-example.md`\n",
            set(),
            None,
            None,
            0,
        ),
        (
            "allowlisted missing claim was wrongly flagged",
            f"`{future_path}`\n",
            {future_path},
            None,
            None,
            0,
        ),
        (
            "stale allowlist entry over an existing file passed",
            f"`{future_path}`\n",
            {future_path},
            future_path,
            None,
            1,
        ),
        (
            "unused allowlist entry passed",
            "`docs/specs/01-sample.md`\n",
            {future_path},
            None,
            None,
            1,
        ),
        (
            "symlink claim target was not treated as present",
            "`docs/specs/link.md`\n",
            set(),
            None,
            ("docs/specs/link.md", "01-sample.md"),
            0,
        ),
    ]
    failures: list[str] = []
    for name, spec_text, declared, materialize, symlink, expected in probes:
        with tempfile.TemporaryDirectory() as td:
            root = _build_probe_tree(
                td, spec_text=spec_text, materialize=materialize, symlink=symlink
            )
            with contextlib.redirect_stdout(io.StringIO()):
                rc = run(root, declared_future=declared)
            if rc != expected:
                failures.append(name)
    if failures:
        for f in failures:
            print(f"check-doc-paths self-test FAIL: {f}")
        return 1
    print("check-doc-paths self-test: all claim, fence, and allowlist probes pass")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--root", type=Path, default=REPO_ROOT)
    parser.add_argument(
        "--self-test",
        action="store_true",
        help="run firing self-tests for check-doc-paths",
    )
    args = parser.parse_args(argv)
    if args.self_test:
        return self_test()
    return run(args.root.resolve())


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception as exc:  # pragma: no cover  # noqa: BLE001 approved [DOM-10.2.1] [RUFF-SUP-065] exception
        print(f"check-doc-paths: internal error: {exc}")
        sys.exit(2)
