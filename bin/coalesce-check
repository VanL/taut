#!/usr/bin/env python3
"""Evidence trail for the coalescing layer's session-start check.

The run log's ``source_sha`` cues are the layer's retrieval contract, and
until this gate they were unchecked prose — the 2026-07-28 field audit found
cues that resolve locally but not in published history. This tool:

  1. verifies every ``<sha>`` cited in ``docs/coalescing.md`` resolves
     (``git cat-file -e``), here or in a named sibling repository;
  2. verifies every ``git show <sha>:<path>`` cue's path exists at that SHA;
  3. checks each locally-resolving SHA against the published remote,
     reporting ``local-only pin`` where it is not an ancestor of
     ``origin/main`` — a cue that survives only on one machine is a claim
     the world cannot verify;
  4. derives the lessons-tier counts with taut's **declared** derivation so
     a session-start check can quote real numbers rather than remembered
     ones.

Adopted from agent-guidance @ ``51626db`` via
``docs/plans/2026-07-28-agent-guidance-delta-wave-plan.md`` (adaptations
A4-A6: sibling list re-pointed at agent-guidance and away from self; the
lessons regex takes the trailing colon of taut's declared derivation
command; the count is additionally reported past the lessons watermark,
because taut's threshold is denominated that way).

This tool covers the lessons tier and the cue contract only. The plans tier
stays with ``bin/check-plan-status-index``; promotion stays with the
judgment clustering in ``skills/coalescing/SKILL.md``.

Read-only by construction. Exit 1 only on an unresolvable cue (a broken
retrieval contract); ``local-only pin`` and count reports are informational
— publication discipline is the owner's call. Exit 2 on an invocation or
environment problem.
"""

from __future__ import annotations

import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
STATE = REPO_ROOT / "docs" / "coalescing.md"
LESSONS = REPO_ROOT / "docs" / "lessons.md"

SHA_RE = re.compile(r"`([0-9a-f]{7,40})`")
CUE_RE = re.compile(r"git show ([0-9a-f]{7,40}):([A-Za-z0-9_./-]+)")

# taut's declared lessons derivation (skills/coalescing/SKILL.md step 2):
#   grep -E '^- 20[0-9]{2}-[0-9]{2}-[0-9]{2}:' docs/lessons.md
# The trailing colon is part of the contract; keep it.
LESSON_RE = re.compile(r"^- (20[0-9]{2}-[0-9]{2}-[0-9]{2}):", re.MULTILINE)
WATERMARK_RE = re.compile(
    r"^\|\s*Lessons\s*\|\s*(20[0-9]{2}-[0-9]{2}-[0-9]{2})\s*\|", re.MULTILINE
)

# Foreign attribution is a REPORTING aid, never a resolution mechanism: it
# names repositories this repo's own citations refer to, makes no filesystem
# assumption, and resolves nothing.
FOREIGN_MARKERS = (
    "agent-theory",
    "agent-guidance",
    "mm",
    "weft",
    "taut",
    "backstitch",
    "engram",
    "simplebroker",
)

# Opt-in local convenience, unset by default. A sibling working copy is an
# environment fact, not a portability claim: anything found this way is
# reported separately and never counted as verified.
SIBLING_ROOT = os.environ.get("COALESCE_SIBLING_ROOT")


@dataclass(frozen=True, slots=True)
class ClaimClassification:
    sha_count: int
    cue_count: int
    broken: tuple[str, ...]
    local_only: tuple[str, ...]
    foreign: tuple[str, ...]


def git(*args: str, repo: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(repo or REPO_ROOT), *args],
        capture_output=True,
        text=True,
        check=False,
    )


def attributed_repo(text: str, pos: int) -> str | None:
    """Does the citation name the repository it came from? Reporting only."""
    ctx = text[max(0, pos - 80) : pos].lower()
    hits = [m for m in FOREIGN_MARKERS if m in ctx]
    return max(hits, key=len) if hits else None


def resolves_locally(sha: str) -> bool:
    return git("cat-file", "-e", f"{sha}^{{commit}}").returncode == 0


def in_local_checkout(sha: str) -> str | None:
    """Opt-in only (COALESCE_SIBLING_ROOT). Environment-dependent by nature,
    so the caller reports it as such and never as verification."""
    if not SIBLING_ROOT:
        return None
    root = Path(SIBLING_ROOT)
    if not root.is_dir():
        return None
    for cand in sorted(root.iterdir()):
        if (cand / ".git").exists() and git(
            "cat-file", "-e", f"{sha}^{{commit}}", repo=cand
        ).returncode == 0:
            return cand.name
    return None


def lessons_counts() -> tuple[int, int | None, str | None]:
    """Return (total dated entries, entries past the lessons watermark, watermark)."""
    if not LESSONS.is_file():
        return 0, None, None
    dates = LESSON_RE.findall(LESSONS.read_text())
    watermark = None
    if STATE.is_file():
        match = WATERMARK_RE.search(STATE.read_text())
        if match:
            watermark = match.group(1)
    past = None if watermark is None else sum(1 for d in dates if d > watermark)
    return len(dates), past, watermark


def classify_claims(
    text: str,
    *,
    remote_ok: bool,
) -> ClaimClassification:
    """Classify claims and broken cues without owning report or exit policy."""

    sha_hits = [(m.group(1), m.start()) for m in SHA_RE.finditer(text)]
    cues = sorted(set(CUE_RE.findall(text)))
    broken: list[str] = []
    local_only: list[str] = []
    foreign: list[str] = []
    seen: set[str] = set()
    for sha, pos in sha_hits:
        if sha in seen:
            continue
        seen.add(sha)
        if resolves_locally(sha):
            if (
                remote_ok
                and git("merge-base", "--is-ancestor", sha, "origin/main").returncode
                != 0
            ):
                local_only.append(sha)
            continue
        who = attributed_repo(text, pos)
        if who:
            extra = in_local_checkout(sha)
            foreign.append(
                f"{sha} @ {who}"
                + (f" (present in a local checkout of {extra})" if extra else "")
            )
        else:
            broken.append(
                f"`{sha}` resolves nowhere here and names no "
                "repository — a cue must say where it is retrievable"
            )

    for sha, path in cues:
        if not (
            resolves_locally(sha)
            and git("cat-file", "-e", f"{sha}:{path}").returncode == 0
        ):
            broken.append(f"cue `git show {sha}:{path}` does not resolve here")
    return ClaimClassification(
        sha_count=len(seen),
        cue_count=len(cues),
        broken=tuple(broken),
        local_only=tuple(local_only),
        foreign=tuple(foreign),
    )


def main() -> int:
    if not STATE.is_file():
        print("coalesce-check: no docs/coalescing.md — nothing to check")
        return 0
    text = STATE.read_text()

    if git("rev-parse", "--is-shallow-repository").stdout.strip() == "true":
        # History-dependent legs cannot be truthful here; skip loudly.
        # (Adopted from agent-theory @ 0423923 — scaffold contract
        # change: was false BROKEN/exit 1 on shallow clones.)
        cues = sorted(set(CUE_RE.findall(text)))
        print(
            "coalesce-check: shallow clone detected — SHA-resolution and "
            "retrieval-cue checks SKIPPED (history absent; cues cannot be "
            "verified here). Enforcement requires full history "
            "(fetch-depth: 0)."
        )
        print(f"  retrieval cues found (syntax only, unverified here): {len(cues)}")
        total, past, watermark = lessons_counts()
        print(
            f"  lessons dated entries: {total} total, {past} past the "
            f"{watermark} watermark"
        )
        return 0

    # Known limitation (hub lessons 2026-08-07): the ancestry check

    # hardcodes origin/main; a consumer with a different default branch

    # gets false local-only-pin reports. Fix candidate: resolve the

    # default via origin/HEAD, falling back to origin/main.

    remote_ok = (
        git("rev-parse", "--verify", "origin/HEAD").returncode == 0
        or git("rev-parse", "--verify", "origin/main").returncode == 0
    )

    classification = classify_claims(
        text,
        remote_ok=remote_ok,
    )

    total, past, watermark = lessons_counts()

    print(
        f"coalesce-check: {classification.sha_count} SHA claim(s) "
        f"({len(classification.foreign)} foreign claim(s)), "
        f"{classification.cue_count} retrieval cue(s)"
    )
    if watermark is None:
        print(f"  lessons dated entries: {total} (no lessons watermark found)")
    else:
        print(
            f"  lessons dated entries: {total} total, {past} past the "
            f"{watermark} watermark"
        )
    if classification.foreign:
        print(
            f"  foreign claim ({len(classification.foreign)}) — not verifiable "
            "in this repository;\n    check the citing repository: "
            + ", ".join(classification.foreign)
        )
    if classification.local_only:
        print(
            f"  local-only pin ({len(classification.local_only)}): "
            + ", ".join(classification.local_only)
            + "  [not in origin/main — published history cannot verify these]"
        )
    if classification.broken:
        print(f"  BROKEN ({len(classification.broken)}):")
        for item in classification.broken:
            print(f"    {item}")
        return 1
    print(
        "  all cues resolve"
        + ("" if remote_ok else "  [no origin remote — publication check skipped]")
    )
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # pragma: no cover  # noqa: BLE001 approved [DOM-10.2.1] [RUFF-SUP-065] exception
        print(f"coalesce-check: internal error: {exc}")
        sys.exit(2)
